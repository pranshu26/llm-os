#!/bin/sh

usage() {
    printf '%s\n' 'Usage: llm-run {interactive|background} -- COMMAND [ARG...]'
}

case "${1-}" in
    -h|--help)
        if [ "$#" -eq 1 ]; then
            usage
            exit 0
        fi
        ;;
    interactive|background)
        if [ "$#" -ge 3 ] && [ "$2" = -- ] && [ -n "$3" ]; then
            workload=$1
            shift 2
            exec systemd-run --user --scope --quiet --expand-environment=no \
                --slice="llm-$workload.slice" --description="LLM $workload workload" \
                -- "$@"
        fi
        ;;
esac

usage >&2
exit 2
